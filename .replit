modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
IMAP_SERVER = "imap.gmail.com"
FLASK_SECRET_KEY = "fda28d205d8fdce273b8877db78919b7ea77d131f42599f0e4fc88225ff4190c"

[deployment]
deploymentTarget = "autoscale"
run = ["python", "-m", "gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "main:app"]
